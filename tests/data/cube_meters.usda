#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
)
# A cube 0.02 units on a side, authored in METERS (metersPerUnit=1). It must load as a 20mm cube
# (0.02 * 1 * 1000). Without metersPerUnit scaling it would be 0.02mm -- far below one layer.
def Mesh "cube"
{
    point3f[] points = [(0,0,0),(0.02,0,0),(0.02,0.02,0),(0,0.02,0),(0,0,0.02),(0.02,0,0.02),(0.02,0.02,0.02),(0,0.02,0.02)]
    int[] faceVertexCounts = [4,4,4,4,4,4]
    int[] faceVertexIndices = [0,3,2,1, 4,5,6,7, 0,1,5,4, 1,2,6,5, 2,3,7,6, 3,0,4,7]
    uniform token subdivisionScheme = "catmullClark"
}
