#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 0.001
)
# Closed all-TRIANGLE octahedron (non-quad control cage). catmullClark -> a smooth blob. Exercises the
# adaptive path's non-quad route: one Catmull-Clark step makes it all-quad (limit surface unchanged),
# then the normal adaptive per-face dicing runs. The --gate proves band-count invariance survives it.
def Mesh "octa"
{
    point3f[] points = [(15,0,0),(-15,0,0),(0,15,0),(0,-15,0),(0,0,15),(0,0,-15)]
    int[] faceVertexCounts = [3,3,3,3,3,3,3,3]
    int[] faceVertexIndices = [0,2,4, 2,1,4, 1,3,4, 3,0,4, 2,0,5, 1,2,5, 3,1,5, 0,3,5]
    uniform token subdivisionScheme = "catmullClark"
}
