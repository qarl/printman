#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 0.001
)
# One prototype cube (abstract class), scene-graph-INSTANCED three times; i2 is mirrored in X (det<0).
# Traverse() alone skips instance proxies, so the fix must traverse them and bake each to world.
class "Proto"
{
    def Mesh "cube"
    {
        point3f[] points = [(0,0,0),(10,0,0),(10,10,0),(0,10,0),(0,0,10),(10,0,10),(10,10,10),(0,10,10)]
        int[] faceVertexCounts = [4,4,4,4,4,4]
        int[] faceVertexIndices = [0,3,2,1, 4,5,6,7, 0,1,5,4, 1,2,6,5, 2,3,7,6, 3,0,4,7]
        uniform token subdivisionScheme = "catmullClark"
    }
}

def Xform "i0" (
    instanceable = true
    prepend references = </Proto>
)
{
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Xform "i1" (
    instanceable = true
    prepend references = </Proto>
)
{
    double3 xformOp:translate = (25, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Xform "i2" (
    instanceable = true
    prepend references = </Proto>
)
{
    double3 xformOp:translate = (60, 10, 0)
    float3 xformOp:scale = (-1, 1, 1)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}
